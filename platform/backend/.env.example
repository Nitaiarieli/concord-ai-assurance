# Local sandbox API only. Use a generated value with at least 24 random characters.
CONCORD_API_TOKEN=
# Optional exact origin for a separately hosted client. Blank means no browser CORS access.
CONCORD_ALLOWED_ORIGIN=
# BookStack service-account visibility is not affected-identity verification.
BOOKSTACK_URL=
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=
# Optional model integration; does not affect policy or verification.
GOOGLE_API_KEY=
CONCORD_GEMINI_MODEL=
# External tracing stays disabled by default.
LANGSMITH_TRACING=false
